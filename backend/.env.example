# ==========================================
# SourceMind Backend Environment Variables
# ==========================================

# Port (Render assigns PORT automatically, local default: 5000)
PORT=5000
NODE_ENV=production

# Database URL (Provided by Render PostgreSQL instance - use Internal URL if backend is on Render)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/documind

# JWT Secrets for Authentication (Generate strong random 64-char strings)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# AI / Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Email Verification (Resend)
RESEND_API_KEY=re_your_resend_api_key_here

# Real-time Web & News Search (Tavily)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# Optional: YouTube transcript extraction
RAPIDAPI_KEY=your_rapidapi_key_here

# Vector chunking batch size (Default: 50)
BATCH_SIZE=50

# Frontend URL (For CORS allowlist in production)
FRONTEND_URL=https://documindai.dev
